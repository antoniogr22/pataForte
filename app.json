{
  "expo": {
    "name": "PataForte",
    "slug": "pataforte",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pataforte",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.pataforte.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir que o PataForte acesse suas fotos para adicionar a foto do pet."
        }
      ]
    ]
  }
}
